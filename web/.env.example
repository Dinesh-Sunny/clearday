# Clearday web + agent. Copy to .env.local and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Clearday policy service (python3 ../app/server.py)
POLICY_URL=http://127.0.0.1:8787
# Next.js proxy -> LangGraph dev server
LANGGRAPH_API_URL=http://localhost:2124
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent
LANGSMITH_TRACING=false
# Only if your API key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
