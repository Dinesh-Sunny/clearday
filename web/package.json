{
  "name": "clearday-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n policy,agent,web -c yellow,magenta,cyan \"python3 ../app/server.py\" npm:dev:backend npm:dev:frontend",
    "dev:frontend": "next dev --turbopack -p 3100",
    "dev:backend": "langgraphjs dev --port 2124 --no-browser",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.30",
    "@assistant-ui/react-langchain": "^0.0.37",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@base-ui/react": "^1.9.0",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/langgraph-sdk": "^1.12.5",
    "@langchain/react": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zustand": "^5.0.15",
    "deepagents": "^1.15.1",
    "@json-render/core": "^0.21.1",
    "@json-render/react": "^0.21.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@assistant-ui/next": "^0.0.25",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph-cli": "^1.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}